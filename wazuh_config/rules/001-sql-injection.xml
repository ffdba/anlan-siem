<!--
  安澜·SIEM 安全监测系统
  规则组：SQL 注入检测
  检测类型：关键词注入、布尔盲注、时间盲注、认证绕过
  MITRE ATT&CK: T1190 (Exploit Public-Facing Application)
-->
<group name="web-attacks, sql-injection,">

  <!-- 检测 URL 中包含 SQL 关键词（SELECT FROM, UNION SELECT, DROP TABLE 等） -->
  <rule id="100001" level="12">
    <if_sid>100000,100005,100006</if_sid>
    <field name="url" type="pcre2">(?i)(?:\bUNION(?:\+|%20|\s)+(?:ALL(?:\+|%20|\s)+)?SELECT\b|\bSELECT(?:\+|%20|\s)+.+(?:\+|%20|\s)+FROM\b|\bDROP(?:\+|%20|\s)+TABLE\b|xp_cmdshell)</field>
    <description>检测到 SQL 注入攻击 - URL 中包含 SQL 关键词</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <options>no_full_log</options>
    <group>web_attack,sql_injection,</group>
  </rule>

  <!-- 检测布尔盲注/永真条件（or 1=1, and 1=1, ' OR '1'='1） -->
  <rule id="100002" level="12">
    <if_sid>100000,100005,100006</if_sid>
    <field name="url" type="pcre2">(?i)(?:['"]|%27|%22)(?:\+|%20|\s)*(?:or|and)(?:\+|%20|\s)+(?:['"]|%27|%22)?\d+(?:['"]|%27|%22)?(?:=|%3d)(?:['"]|%27|%22)?\d+|(?:'|%27)--</field>
    <description>检测到 SQL 注入攻击 - 布尔盲注/永真条件</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,sql_injection,</group>
  </rule>

  <!-- 检测时间盲注（sleep, waitfor delay, pg_sleep, benchmark） -->
  <rule id="100003" level="12">
    <if_sid>100000,100005,100006</if_sid>
    <field name="url" type="pcre2">(?i)\b(?:sleep|pg_sleep|benchmark)(?:\(|%28)\d+|waitfor(?:\+|%20|\s)+delay</field>
    <description>检测到 SQL 注入攻击 - 时间盲注</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,sql_injection,</group>
  </rule>

  <!-- 检测认证绕过尝试与数据库元信息探测 -->
  <rule id="100004" level="12">
    <if_sid>100000,100005,100006</if_sid>
    <field name="url" type="pcre2">(?i)(?:admin(?:'|%27)(?:\+|%20|\s)*--|information_schema|(?:'|%27)(?:\+|%20|\s)+or(?:\+|%20|\s)+(?:'|%27)x(?:'|%27)(?:=|%3d)(?:'|%27)x)</field>
    <description>检测到 SQL 注入攻击 - 认证绕过尝试</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,sql_injection,</group>
  </rule>

</group>
