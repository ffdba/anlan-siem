<!--
  安澜·SIEM 安全监测系统
  通用 Web 日志解码器
  支持标准 Combined Log Format (CLF)
-->
<decoder name="web-access-log">
    <type>web-log</type>
    <prematch type="pcre2">^(?:ANLAN_WEB )?[0-9a-fA-F:.]+ \S+ \S+ \[</prematch>
</decoder>

<decoder name="web-access-log-detail">
    <parent>web-access-log</parent>
    <regex type="pcre2">^(?:ANLAN_WEB )?([0-9a-fA-F:.]+) \S+ \S+ \[([^\]]+)\] "(\S+) (\S+) HTTP/[^"]*" (\d{3}) (\d+|-)(?: "([^"]*)" "([^"]*)")?$</regex>
    <order>srcip,log_timestamp,http_method,url,status_code,response_size,referer,user_agent</order>
</decoder>

<decoder name="web-error-log">
    <prematch type="pcre2">^\[[^\]]+\] \[error\] \[client </prematch>
</decoder>

<decoder name="web-error-log-detail">
    <parent>web-error-log</parent>
    <regex type="pcre2">^\[([^\]]+)\] \[(\w+)\] \[client ([0-9a-fA-F:.]+)\] (.+)$</regex>
    <order>log_timestamp,error_level,srcip,error_message</order>
</decoder>
