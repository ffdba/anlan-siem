<!--
  安澜·SIEM 安全监测系统
  Apache HTTP Server 专用解码器
-->
<decoder name="apache-access-log">
    <type>web-log</type>
    <prematch type="pcre2">^ANLAN_APACHE </prematch>
    <regex type="pcre2">^ANLAN_APACHE ([0-9a-fA-F:.]+) \S+ \S+ \[([^\]]+)\] "(\S+) (\S+) HTTP/[^"]*" (\d{3}) (\d+|-)(?: "([^"]*)" "([^"]*)")?$</regex>
    <order>srcip,log_timestamp,http_method,url,status_code,response_size,referer,user_agent</order>
</decoder>

<decoder name="apache-error-log">
    <prematch type="pcre2">^\[[^\]]+\] \[\w+:\w+\] \[pid </prematch>
</decoder>

<decoder name="apache-error-log-detail">
    <parent>apache-error-log</parent>
    <regex type="pcre2">^\[([^\]]+)\] \[([^\]]+)\] \[pid \d+\] \[client ([0-9a-fA-F:.]+):\d+\] (.+)$</regex>
    <order>log_timestamp,module,srcip,error_message</order>
</decoder>
